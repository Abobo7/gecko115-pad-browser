{
  "manifest_version": 2,
  "name": "GeckoPad Modern WebCompat Polyfills",
  "version": "1.2.1",
  "description": "ES2024-ES2026 & Intl.Segmenter compatibility layer for GeckoView 115 on Android 4.4 KitKat.",
  "browser_specific_settings": {
    "gecko": {
      "id": "webcompat@mipad.geckobrowser"
    }
  },
  "permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["polyfill.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
